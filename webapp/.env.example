# Copy to .env.local and fill in. .env.local is gitignored.

# Public — safe for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. Used by route handlers
# that need to bypass RLS (e.g. service-role tasks).
SUPABASE_SERVICE_ROLE_KEY=

# Allowlist for magic-link sign-in. Comma-separated emails.
ALLOWED_EMAILS=labib@lynxmedia.co
