# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase ---
# Public — safe for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never exposed to the browser. Used by route handlers
# that need to bypass RLS (service-role tasks).
SUPABASE_SERVICE_ROLE_KEY=

# --- App lock (PIN gate) ---
# 4-digit PIN that unlocks the app. Default 3245.
APP_PIN=3245

# 32-byte random hex used to HMAC-sign the session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Unipile (overridable from /settings once you've set them once) ---
UNIPILE_API_KEY=
UNIPILE_DSN=
UNIPILE_LINKEDIN_ACCOUNT_ID=

# --- OpenRouter ---
OPENROUTER_API_KEY=
# claude-3.5-haiku is fast (2-3s typical) — fits Vercel Hobby's 10s
# function ceiling. Switch to anthropic/claude-3.5-sonnet for higher
# quality on Pro plans (5-8s typical).
OPENROUTER_TEXT_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_IMAGE_MODEL=openai/gpt-5-image-mini
