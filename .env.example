# Copy to .env and fill in. .env is gitignored — never commit secrets.

# ─── SUPABASE (canonical state store) ────────────────────────────
# Create a project at supabase.com, then Settings → API to find these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon key is only needed for the webapp (set in webapp/.env.local instead).
# SUPABASE_ANON_KEY=

# ─── UNIPILE (LinkedIn read/write) ───────────────────────────────
UNIPILE_API_KEY=
UNIPILE_DSN=
UNIPILE_LINKEDIN_ACCOUNT_ID=

# ─── OPENROUTER (image generation via openai/gpt-5-image-mini) ───
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=openai/gpt-5-image-mini
OPENROUTER_HTTP_REFERER=https://lynxmedia.co
OPENROUTER_APP_TITLE=LinkedIn Agent

# ─── TRIGGER.DEV ─────────────────────────────────────────────────
# After creating a project at cloud.trigger.dev:
#   1. Run `npx trigger.dev@latest login` once (browser auth, stored at ~/.config/trigger).
#   2. cloud.trigger.dev → API Keys → create a Server-side key (dev or prod).
#   3. Paste it below. tools/trigger_engagement.py uses this to fire tasks.
TRIGGER_SECRET_KEY=
# TRIGGER_API_BASE=https://api.trigger.dev   # only set if self-hosting

# ─── GOOGLE OAUTH (legacy — only needed for Drive uploads + the
#                   one-time Sheet→Supabase migration) ────────────
# These are NOT needed for the steady-state pipeline once you've migrated.
# The lead-magnet PDF uploader (drive_upload_lead_magnet.py) borrows the
# gspread OAuth credentials cached at ~/.config/gspread/ to call Drive API.
# If you deleted those creds, you can either:
#   - Re-auth gspread (run any sheets_*.py — though those now write to Supabase)
#   - Skip drive_upload_lead_magnet and host PDFs elsewhere
GOOGLE_OAUTH_CLIENT_PATH=~/.config/gspread/client_secret.json
GOOGLE_OAUTH_TOKEN_PATH=~/.config/gspread/authorized_user.json
# Only used by tools/migrate_sheet_to_supabase.py (one-shot, then irrelevant):
LYNX_GROWTH_PLAN_SHEET_ID=

# ─── OPTIONAL (deferred / future) ────────────────────────────────
# Short-link tracking on lead-magnet DMs (Phase B+):
# DUB_API_KEY=
# Booking link for AUDIT lead conversion:
# CALENDLY_LINK=
# Override the Drive folder name for lead-magnet uploads (default: lynx-lead-magnets):
# LYNX_DRIVE_FOLDER=lynx-lead-magnets
